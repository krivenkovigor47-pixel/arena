<div class="sm" data-sm
     data-telegram="{{ widget_settings.sm_telegram }}"
     data-max="{{ widget_settings.sm_max }}"
     data-whatsapp="{{ widget_settings.sm_whatsapp }}">

  {% if widget_settings.sm_lead != blank %}
    <p class="sm__lead">{{ widget_settings.sm_lead }}</p>
  {% endif %}

  <div class="sm__card">
    <div class="sm__card-head">
      <div class="sm__card-title">Куда вам удобнее написать</div>
      <div class="sm__badge">{{ widget_settings.sm_reply }}</div>
    </div>

    <div class="sm__msgs">
      {% if widget_settings.sm_telegram != blank %}
      <button type="button" class="sm__msg sm__msg_tg" data-sm-tg>
        <span class="sm__msg-ico">
          <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
            <path fill="currentColor" d="M9.8 16.2 9.6 20c.5 0 .7-.2 1-.5l2.4-2.3 5 3.6c.9.5 1.6.2 1.8-.9L23 4.4c.3-1.3-.5-1.9-1.4-1.6L2.3 10.2c-1.3.5-1.3 1.2-.2 1.6l4.9 1.5 11.3-7.1c.5-.3 1-.2.6.2l-9.1 9.8z"/>
          </svg>
        </span>
        <span class="sm__msg-text">
          <span class="sm__msg-name">Telegram</span>
          <span class="sm__msg-sub">Текст скопируем в буфер</span>
        </span>
      </button>
      {% endif %}

      {% if widget_settings.sm_max != blank %}
      <button type="button" class="sm__msg sm__msg_mx" data-sm-mx>
        <span class="sm__msg-ico">
          <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
            <path fill="currentColor" fill-rule="evenodd" d="M12 2.6a9 9 0 0 0-6.6 15.1c.3 1.3.2 2.7-.4 3.9-.3.6.2 1.2.8 1.1 1.6-.3 3.1-1.2 4.1-2.5A9 9 0 1 0 12 2.6zm0 4.9a4.1 4.1 0 1 1 0 8.2 4.1 4.1 0 0 1 0-8.2z"/>
          </svg>
        </span>
        <span class="sm__msg-text">
          <span class="sm__msg-name">MAX</span>
          <span class="sm__msg-sub">Текст скопируем в буфер</span>
        </span>
      </button>
      {% endif %}

      {% if widget_settings.sm_whatsapp != blank %}
      <button type="button" class="sm__msg sm__msg_wa" data-sm-wa>
        <span class="sm__msg-ico">
          <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
            <path fill="currentColor" d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2zm0 18.2a8.2 8.2 0 0 1-4.2-1.1l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2zm4.6-6.1c-.3-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1-1.4-.6-2.4-1.6-3.1-2.9-.1-.2 0-.4.1-.5l.5-.6c.1-.2.1-.3 0-.5-.1-.2-.6-1.4-.8-1.9-.2-.5-.4-.4-.6-.4h-.5c-.2 0-.5.1-.7.3-.7.7-1 1.6-.9 2.5.2 1.3.8 2.5 1.7 3.5 1.2 1.6 2.8 2.7 4.7 3.2.6.2 1.2.2 1.8.1.7-.1 1.4-.6 1.7-1.3.2-.4.2-.8.1-1.2l-.4-.2z"/>
          </svg>
        </span>
        <span class="sm__msg-text">
          <span class="sm__msg-name">WhatsApp</span>
          <span class="sm__msg-sub">Сообщение уже готово</span>
        </span>
      </button>
      {% endif %}
    </div>

    {% if widget_settings.sm_phone != blank %}
    <div class="sm__phone">
      Или позвоните:
      <a href="tel:{{ widget_settings.sm_phone | remove: ' ' | remove: '(' | remove: ')' | remove: '-' }}">{{ widget_settings.sm_phone }}</a>
      {% if widget_settings.sm_hours != blank %}<span class="sm__hours">{{ widget_settings.sm_hours }}</span>{% endif %}
    </div>
    {% endif %}
  </div>

  <ol class="sm__steps">
    <li class="sm__step">
      <span class="sm__step-n">01</span>
      <span class="sm__step-t">Пишете в чат</span>
      <span class="sm__step-d">Прикладываете фото сметы, текстовый список или файл прямо в переписке.</span>
    </li>
    <li class="sm__step">
      <span class="sm__step-n">02</span>
      <span class="sm__step-t">{{ widget_settings.sm_reply }}</span>
      <span class="sm__step-d">Уточняем детали там же, в диалоге. Искать в каталоге ничего не нужно.</span>
    </li>
    <li class="sm__step">
      <span class="sm__step-n">03</span>
      <span class="sm__step-t">Присылаем корзину</span>
      <span class="sm__step-d">Ссылка на готовый заказ. Подтверждаете заказ и оформляем доставку.</span>
    </li>
  </ol>

  <div class="sm__card">
    <div class="sm__card-title">Что делаем со сметой</div>
    <div class="sm__grid">
      <div class="sm__item">
        <b>Сверяем позиции</b>
        Находим каждую в наличии, либо предлагаем аналог
      </div>
      <div class="sm__item">
        <b>Ищем аналоги</b>
        Предлагаем дешевле при том же качестве
      </div>
      <div class="sm__item">
        <b>Проверяем количество</b>
        Скажем, если взято мало или с большим перебором
      </div>
      <div class="sm__item">
        <b>Считаем доставку</b>
        С подъёмом на этаж и разгрузкой
      </div>
    </div>
  </div>

  <div class="sm__what">
    <div class="sm__what-title">Что можно прислать</div>
    <ul class="sm__what-list">
      <li>Фото сметы</li>
      <li>Список в заметках на телефоне</li>
      <li>Спецификацию из проекта</li>
      <li>Фото объекта и размеры</li>
      <li>Расчёт из нашего калькулятора</li>
      <li>Голосовое сообщение с перечислением наименований</li>
    </ul>
  </div>
</div>
